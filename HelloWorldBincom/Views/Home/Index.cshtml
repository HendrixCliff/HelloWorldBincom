@{
    ViewData["Title"] = "Hello World";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelloWorldBincom</title>

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f7fb;
            color: #1f2937;
        }

        .hello-world {
            text-align: center;
            background: white;
            padding: 50px 70px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        h1 {
            margin: 0 0 15px;
            color: #2563eb;
            font-size: 48px;
        }

        p {
            margin: 0;
            font-size: 20px;
            color: #4b5563;
        }
    </style>
</head>

<body>
    <main class="hello-world">
        <h1>Hello World!</h1>
        <p>Hello from the HelloWorldBincom ASP.NET Core MVC application.</p>
    </main>
</body>
</html>